{
  "name": "Navaja PDF",
  "short_name": "Navaja PDF",
  "description": "Herramientas de PDF e imágenes dentro del navegador, sin subir tus archivos: Office a PDF, unir, dividir, comprimir, firmar, editar, recortar y más.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f7",
  "theme_color": "#2A6478",
  "lang": "es",
  "icons": [
    {
      "src": "icono.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icono-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icono-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./compartir/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "archivos",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*",
            ".docx",
            ".xlsx",
            ".pptx",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation"
          ]
        }
      ]
    }
  }
}
